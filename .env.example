# Google AI Studio key for the Gemini model behind /api/chat.
# Get one at https://aistudio.google.com/apikey
#
# Local dev reads this file. In production the value is a Cloudflare secret,
# NOT a var in wrangler.jsonc:
#   npx wrangler secret put GOOGLE_GENERATIVE_AI_API_KEY
GOOGLE_GENERATIVE_AI_API_KEY=
