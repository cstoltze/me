---
import Layout from "../layouts/Layout.astro";
import ChatInterface from "../components/ChatInterface.svelte";
---

<Layout title="Coleman Stoltze | Systems Thinker">
  <main class="min-h-screen flex flex-col items-center justify-center p-4 md:p-8 relative overflow-hidden">
    <!-- Background Accents -->
    <div class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] bg-accent-purple/20 blur-[120px] rounded-full"></div>
    <div class="absolute bottom-[-10%] right-[-10%] w-[40%] h-[40%] bg-accent-cyan/20 blur-[120px] rounded-full"></div>

    <!-- Nav / Header -->
    <header class="fixed top-8 left-1/2 -translate-x-1/2 z-50 w-[min(90%,1100px)]">
      <nav class="frosted-satin rounded-2xl px-8 py-5 flex justify-between items-center">
        <a
          href="/"
          class="text-xl font-black tracking-tighter text-white hover:text-brand-400 transition-colors"
        >
          CS<span class="text-brand-400">.</span>
        </a>
        <div class="flex items-center gap-10">
          <a
            href="/resume"
            data-astro-prefetch
            class="text-[10px] font-black tracking-[0.2em] uppercase text-white/50 hover:text-white transition-colors"
          >
            Experience
          </a>
          <a
            href="https://github.com/cstoltze"
            target="_blank"
            class="px-5 py-2 rounded-lg bg-white/5 hover:bg-brand-400/10 hover:text-brand-400 text-[10px] font-black uppercase tracking-[0.2em] transition-all border border-white/5 hover:border-brand-400/30"
          >
            GitHub
          </a>
        </div>
      </nav>
    </header>

    <!-- Hero Section -->
    <section class="w-full max-w-5xl mt-48 mb-24 text-center px-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-400/10 border border-brand-400/20 mb-8">
        <span class="w-1.5 h-1.5 rounded-full bg-brand-400 animate-pulse"></span>
        <span class="text-[9px] font-black uppercase tracking-[0.2em] text-brand-400">
          Systems Thinker &amp; Software Engineer
        </span>
      </div>
      <h1 class="text-6xl md:text-8xl font-black tracking-tighter mb-10 leading-[0.8] text-gradient">
        Systems first.
        <br />
        Code second.
      </h1>
      <p class="text-lg md:text-xl font-light text-white/60 tracking-tight max-w-2xl mx-auto leading-relaxed">
        I build backends that hold up, lead teams that ship, and care more about
        whether a system keeps working than how clever it looks.
      </p>
    </section>

    <!-- Chat Interface Container -->
    <section class="w-full max-w-6xl relative z-10 mb-32 group px-4">
      <div class="absolute -inset-1 bg-gradient-to-b from-brand-400/20 to-transparent rounded-[2.5rem] blur-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
      <div class="relative bg-slate-950/80 backdrop-blur-3xl rounded-[2.5rem] overflow-hidden border border-white/10 shadow-[0_30px_100px_-20px_rgba(0,0,0,0.8)]">
        <!-- Interface Terminal Header -->
        <div class="px-8 py-6 border-b border-white/5 flex items-center justify-between bg-white/[0.02]">
          <div class="flex items-center gap-6">
            <div class="flex gap-2">
              <div class="w-3 h-3 rounded-full bg-white/5 border border-white/10"></div>
              <div class="w-3 h-3 rounded-full bg-white/5 border border-white/10"></div>
              <div class="w-3 h-3 rounded-full bg-white/5 border border-white/10"></div>
            </div>
            <div class="h-4 w-px bg-white/10"></div>
            <span class="text-[9px] font-black uppercase tracking-[0.4em] text-white/30">
              Digital Advocate
            </span>
          </div>
          <div class="flex items-center gap-4 px-4 py-2 rounded-full bg-brand-400/5 border border-brand-400/10">
            <span class="w-1.5 h-1.5 rounded-full bg-brand-400 shadow-[0_0_8px_rgba(34,211,238,0.8)]"></span>
            <span class="text-[8px] font-black uppercase tracking-[0.3em] text-brand-400">
              Online
            </span>
          </div>
        </div>
        <ChatInterface client:load />
      </div>
    </section>

    <!-- Footer -->
    <footer class="mt-auto py-12 text-center text-white/20 text-[10px] font-bold uppercase tracking-[0.2em]">
      &copy; {new Date().getFullYear()} Coleman Stoltze &bull; Built with Astro
      & Svelte
    </footer>
  </main>
</Layout>
