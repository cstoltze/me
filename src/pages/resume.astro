---
import Layout from "../layouts/Layout.astro";
import ResumeItem from "../components/ResumeItem.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import profile from "../data/profile.json";
import { startedAt } from "../lib/dates";
import Mail from "lucide-astro/Mail";
import Phone from "lucide-astro/Phone";
import Globe from "lucide-astro/Globe";
import MapPin from "lucide-astro/MapPin";
import Github from "lucide-astro/Github";
import ArrowLeft from "lucide-astro/ArrowLeft";
import Printer from "lucide-astro/Printer";

const experience = await getCollection("experience");

const sortedExperience = [...experience].sort(
  (a: CollectionEntry<"experience">, b: CollectionEntry<"experience">) =>
    startedAt(b.data.dates) - startedAt(a.data.dates),
);
---

<Layout title={`Resume - ${profile.name}`}>
  <main class="min-h-screen w-full py-12 md:py-24 px-4 md:px-8 print:p-0">
    <!-- Navigation (Screen Only) -->
    <nav class="max-w-6xl mx-auto mb-16 print:hidden flex justify-between items-center px-4">
      <a
        href="/"
        data-astro-prefetch
        class="group flex items-center gap-4 px-6 py-3 rounded-xl frosted-satin hover:bg-white/[0.05] transition-all border border-white/5"
      >
        <ArrowLeft class="w-4 h-4 text-brand-400 group-hover:-translate-x-1 transition-transform" />
        <span class="text-[10px] font-black tracking-[0.2em] uppercase text-white/50 group-hover:text-white">
          Back
        </span>
      </a>
      <button
        onclick="window.print()"
        class="group flex items-center gap-4 px-6 py-3 rounded-xl frosted-satin hover:bg-white/[0.05] transition-all border border-white/5"
      >
        <Printer class="w-4 h-4 text-brand-400 group-hover:scale-110 transition-transform" />
        <span class="text-[10px] font-black tracking-[0.2em] uppercase text-white/50 group-hover:text-white">
          Print
        </span>
      </button>
    </nav>

    <!-- Resume Container -->
    <div class="max-w-6xl mx-auto glass rounded-[2.5rem] overflow-hidden flex flex-col md:grid md:grid-cols-[300px_1fr] min-h-[1100px] border border-white/10 shadow-2xl print:shadow-none print:grid-cols-[240px_1fr] print:rounded-none print:border-none print:bg-white print:text-black">
      <!-- Sidebar (Left Column) -->
      <aside class="bg-black/40 p-10 flex flex-col gap-12 border-r border-white/5 print:p-8 print:bg-white print:border-r-2 print:border-gray-200">
        <!-- Profile Mini -->
        <div class="space-y-4">
          <div class="w-16 h-1 bg-brand-500 rounded-full print:bg-blue-600"></div>
          <h2 class="text-xs font-black uppercase tracking-[0.3em] text-brand-400 print:text-blue-600">
            Contact
          </h2>
          <div class="space-y-4 pt-2">
            <a
              href={`mailto:${profile.contact.email}`}
              class="flex items-center gap-4 text-white/60 hover:text-white transition-colors group print:text-gray-700"
            >
              <div class="w-8 h-8 rounded-lg bg-white/5 flex items-center justify-center group-hover:bg-brand-500/20 transition-colors print:hidden">
                <Mail class="w-4 h-4" />
              </div>
              <span class="text-xs font-medium truncate">
                {profile.contact.email}
              </span>
            </a>

            <a
              href={`tel:${profile.contact.phone}`}
              class="flex items-center gap-4 text-white/60 hover:text-white transition-colors group print:text-gray-700"
            >
              <div class="w-8 h-8 rounded-lg bg-white/5 flex items-center justify-center group-hover:bg-brand-500/20 transition-colors print:hidden">
                <Phone class="w-4 h-4" />
              </div>
              <span class="text-xs font-medium">{profile.contact.phone}</span>
            </a>

            <a
              href={`https://${profile.contact.website}`}
              class="flex items-center gap-4 text-white/60 hover:text-white transition-colors group print:text-gray-700"
            >
              <div class="w-8 h-8 rounded-lg bg-white/5 flex items-center justify-center group-hover:bg-brand-500/20 transition-colors print:hidden">
                <Globe class="w-4 h-4" />
              </div>
              <span class="text-xs font-medium">{profile.contact.website}</span>
            </a>

            <div class="flex items-center gap-4 text-white/60 print:text-gray-700">
              <div class="w-8 h-8 rounded-lg bg-white/5 flex items-center justify-center print:hidden">
                <MapPin class="w-4 h-4" />
              </div>
              <span class="text-xs font-medium">{profile.location}</span>
            </div>

            <a
              href={`https://github.com/${profile.contact.github}`}
              class="flex items-center gap-4 text-white/60 hover:text-white transition-colors group print:text-gray-700"
            >
              <div class="w-8 h-8 rounded-lg bg-white/5 flex items-center justify-center group-hover:bg-brand-500/20 transition-colors print:hidden">
                <Github class="w-4 h-4" />
              </div>
              <span class="text-xs font-medium">{profile.contact.github}</span>
            </a>
          </div>
        </div>

        <!-- Skills -->
        <div class="space-y-10">
          <h2 class="text-[10px] font-black uppercase tracking-[0.4em] text-brand-400/50 print:text-blue-600">
            Technical Stack
          </h2>

          <div class="space-y-8">
            <div>
              <h3 class="text-[9px] font-black uppercase tracking-[0.2em] text-white/20 mb-4 print:text-gray-400">
                Systems & Backend
              </h3>
              <div class="flex flex-wrap gap-2">
                {profile.skills.backend.map((skill) => (
                  <span class="px-2 py-1 bg-white/5 text-[10px] font-bold text-white/70 rounded border border-white/10 print:bg-gray-100 print:text-black print:border-gray-200">
                    {skill}
                  </span>
                ))}
              </div>
            </div>

            <div>
              <h3 class="text-[10px] font-bold uppercase tracking-widest text-white/30 mb-3 print:text-gray-400">
                Frontend
              </h3>
              <div class="flex flex-wrap gap-2">
                {profile.skills.frontend.map((skill) => (
                  <span class="px-2 py-1 bg-white/5 text-[10px] font-bold text-white/70 rounded border border-white/10 print:bg-gray-100 print:text-black print:border-gray-200">
                    {skill}
                  </span>
                ))}
              </div>
            </div>

            <div>
              <h3 class="text-[10px] font-bold uppercase tracking-widest text-white/30 mb-3 print:text-gray-400">
                DevOps
              </h3>
              <div class="flex flex-wrap gap-2">
                {profile.skills.devops.map((skill) => (
                  <span class="px-2 py-1 bg-white/5 text-[10px] font-bold text-white/70 rounded border border-white/10 print:bg-gray-100 print:text-black print:border-gray-200">
                    {skill}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- Education -->
        <div class="space-y-6">
          <h2 class="text-xs font-black uppercase tracking-[0.3em] text-brand-400 print:text-blue-600">
            Education
          </h2>
          {profile.education.map((edu) => (
            <div class="space-y-1">
              <div class="text-xs font-bold text-white print:text-black">
                {edu.university}
              </div>
              <div class="text-xs text-white/50 print:text-gray-600">
                {edu.degree}
              </div>
              <div class="text-[10px] font-black tracking-widest uppercase text-white/20 pt-1 print:text-gray-400">
                {edu.dates}
              </div>
            </div>
          ))}
        </div>
      </aside>

      <!-- Main Content (Right Column) -->
      <section class="p-12 md:p-20 bg-white/5 print:p-8 print:bg-white">
        <!-- Header -->
        <header class="mb-20 print:mb-12 border-b border-white/5 pb-16 print:border-gray-100 print:pb-8">
          <h1 class="text-7xl font-black tracking-tighter mb-6 leading-[0.8] text-gradient print:text-4xl print:text-black print:bg-none">
            {profile.name}
          </h1>
          <p class="text-2xl font-light text-brand-400/80 tracking-tight mb-10 print:text-lg print:text-blue-700">
            {profile.tagline}
          </p>
          <p class="text-xl leading-relaxed text-white/40 max-w-3xl font-light print:text-sm print:text-gray-700">
            {profile.professional_summary}
          </p>
        </header>

        <!-- Experience -->
        <div class="space-y-12">
          <h2 class="text-xs font-black uppercase tracking-[0.4em] text-white/20 mb-12 print:text-gray-400">
            Professional Experience
          </h2>
          <div
            id="experience"
            aria-label="Professional experience"
            class="space-y-16 print:space-y-10"
          >
            {sortedExperience.map((entry) => (
              <ResumeItem entry={entry} />
            ))}
          </div>
        </div>
      </section>
    </div>
  </main>
</Layout>

<style is:global>
  @media print {
    .mesh-gradient {
      background: white !important;
    }
    .glass {
      background: white !important;
      backdrop-filter: none !important;
      border: none !important;
      box-shadow: none !important;
    }
    .text-gradient {
      background: none !important;
      -webkit-text-fill-color: black !important;
    }
    @page {
      margin: 1cm;
    }
  }
</style>
