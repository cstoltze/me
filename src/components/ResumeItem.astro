---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'experience'>;
}

const { entry } = Astro.props;
const { title, company, dates, tags } = entry.data;
const { Content } = await entry.render();
---

<div class="mb-12 break-inside-avoid relative pl-4 border-l-2 border-transparent hover:border-gray-200 transition-colors">
  <div class="flex flex-col md:flex-row print:flex-row justify-between items-start print:items-start mb-3">
    <div class="flex flex-col">
      <h3 class="text-lg font-bold text-gray-900 print:text-base leading-tight">{title}</h3>
      <span class="text-md font-medium text-blue-700 print:text-sm mt-0.5">{company}</span>
    </div>
    
    <div class="flex items-center gap-3 text-sm font-medium text-gray-500 print:text-xs mt-1 md:mt-0">
      <span class="font-mono text-xs whitespace-nowrap print:text-[10px] bg-gray-50 px-2 py-1 rounded">{dates}</span>
    </div>
  </div>

  <div class="prose prose-sm max-w-none text-gray-600 leading-relaxed mb-4 
    prose-p:text-gray-600 prose-p:mb-2 prose-p:leading-relaxed prose-p:text-sm print:prose-p:text-[11px]
    prose-ul:list-disc prose-ul:pl-4 prose-ul:mt-2 prose-ul:space-y-1
    prose-li:text-gray-600 prose-li:text-sm prose-li:marker:text-gray-400 print:prose-li:text-[11px]
    print:prose-xs">
    <Content />
  </div>

  {tags && (
    <div class="flex flex-wrap gap-2 mt-4 print:hidden">
      {tags.slice(0, 4).map(tag => (
        <span class="px-2.5 py-1 bg-gray-50 text-[10px] font-bold uppercase tracking-wider text-gray-500 rounded-md border border-gray-200">
          {tag}
        </span>
      ))}
    </div>
  )}
</div>
