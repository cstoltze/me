---
import { marked } from "marked";
import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"experience">;
}

const { entry } = Astro.props;
const { title, company, dates, tags } = entry.data;
const html = await marked.parse(entry.body);
---

<div
  class="group relative pl-8 border-l-2 border-white/5 hover:border-brand-500/50 transition-all duration-500 py-1 print:pl-6 print:border-gray-200 print:py-0 print:border-l-2"
>
  <!-- Dot Marker -->
  <div
    class="absolute left-[-5px] top-3 w-2 h-2 rounded-full bg-brand-500 opacity-0 group-hover:opacity-100 transition-opacity blur-[2px] print:hidden"
  >
  </div>

  <div
    class="flex flex-col md:flex-row print:flex-row justify-between items-start print:items-start mb-6 print:mb-3"
  >
    <div class="flex flex-col gap-1">
      <h3
        class="text-2xl font-black text-white group-hover:text-brand-400 transition-colors print:text-lg print:text-black leading-tight"
      >
        {title}
      </h3>
      <span
        class="text-lg font-medium text-white/40 print:text-sm print:text-blue-700 font-mono tracking-tight"
        >{company}</span
      >
    </div>

    <div class="mt-2 md:mt-0">
      <span
        class="text-[10px] font-black uppercase tracking-[0.2em] text-white/20 bg-white/5 px-3 py-1.5 rounded-full border border-white/5 print:bg-gray-50 print:text-gray-500 print:border-gray-100 print:text-[10px]"
        >{dates}</span
      >
    </div>
  </div>

  <div
    class="prose prose-invert prose-sm max-w-none text-white/60 leading-relaxed mb-6 font-light
    prose-p:mb-4 prose-p:leading-relaxed prose-p:text-base print:prose-p:text-[11px] print:text-black print:prose-p:text-gray-700
    prose-ul:list-disc prose-ul:pl-5 prose-ul:space-y-1.5
    prose-li:marker:text-brand-500 print:prose-li:marker:text-gray-400
    print:prose-xs"
  >
    <div set:html={html} />
  </div>

  {
    tags && (
      <div class="flex flex-wrap gap-2 mt-6 print:hidden">
        {tags.map((tag) => (
          <span class="px-3 py-1 bg-brand-500/5 text-white/30 text-[9px] font-black uppercase tracking-[0.2em] rounded-lg border border-white/5 hover:border-brand-400/20 hover:text-white/60 transition-colors">
            {tag}
          </span>
        ))}
      </div>
    )
  }
</div>
