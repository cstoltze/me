---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'experience'>;
}

const { entry } = Astro.props;
const { title, company, dates, tags } = entry.data;
const { Content } = await entry.render();
---

<div class="mb-12 break-inside-avoid">
  <div class="flex flex-col md:flex-row justify-between items-baseline mb-1">
    <h3 class="text-base font-bold text-gray-900 print:text-sm">{title}</h3>
    <span class="text-gray-500 font-mono text-xs mt-1 md:mt-0 whitespace-nowrap print:text-[10px]">{dates}</span>
  </div>
  <div class="text-xs font-medium text-gray-600 mb-2 print:text-[10px]">{company}</div>

  <div class="prose prose-sm max-w-none text-gray-800 leading-relaxed mb-4 
    prose-p:italic prose-p:text-gray-500 prose-p:mb-2 prose-p:leading-relaxed prose-p:text-xs print:prose-p:text-[10px]
    prose-ul:list-disc prose-ul:pl-4 prose-ul:mt-2 prose-ul:space-y-0.5
    prose-li:text-gray-900 prose-li:not-italic prose-li:text-xs prose-li:marker:text-gray-500 print:prose-li:text-[10px]
    print:prose-xs">
    <Content />
  </div>

  {tags && (
    <div class="flex flex-wrap gap-2 mt-4 print:hidden">
      {tags.map(tag => (
        <span class="px-3 py-1 bg-gray-100 text-xs font-bold uppercase tracking-wider text-gray-600 rounded-full">
          {tag}
        </span>
      ))}
    </div>
  )}
</div>
