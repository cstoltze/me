---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'experience'>;
}

const { entry } = Astro.props;
const { title, company, dates, tags } = entry.data;
const { Content } = await entry.render();
---

<div class="mb-12 break-inside-avoid">
  <div class="flex flex-col md:flex-row md:justify-between md:items-baseline mb-4">
    <div>
      <h3 class="text-2xl font-bold">{title}</h3>
      <h4 class="text-xl text-gray-600 font-medium">{company}</h4>
    </div>
    <span class="text-gray-500 font-mono mt-1 md:mt-0">{dates}</span>
  </div>

  <div class="prose prose-sm max-w-none text-gray-800 leading-relaxed mb-4 
    prose-p:italic prose-p:text-gray-600 prose-p:mb-3 prose-p:leading-relaxed
    prose-ul:list-disc prose-ul:pl-4 prose-ul:mt-4 prose-ul:space-y-1
    prose-li:text-gray-900 prose-li:not-italic prose-li:text-xs prose-li:marker:text-gray-400
    print:prose-xs">
    <Content />
  </div>

  {tags && (
    <div class="flex flex-wrap gap-2 mt-4 print:hidden">
      {tags.map(tag => (
        <span class="px-3 py-1 bg-gray-100 text-xs font-bold uppercase tracking-wider text-gray-600 rounded-full">
          {tag}
        </span>
      ))}
    </div>
  )}
</div>
